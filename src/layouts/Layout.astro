      <!-- Logo (left, large) -->
      <a href="/" class="flex items-center gap-4 group shrink-0">
        <div class="w-14 h-14 rounded-lg bg-verma-dark flex items-center justify-center font-display font-bold text-gold-500 text-xl leading-none select-none shadow-md">B3</div>
        <div class="leading-tight">
          <div class="font-display font-bold text-verma-darkest text-2xl tracking-wide leading-none">B3 Global</div>
          <div class="text-gray-400 text-[10px] tracking-[0.2em] uppercase font-medium mt-0.5">
            <span class="lang-pt">Importação & Exportação</span>
            <span class="lang-en">Import & Export</span>
            <span class="lang-fr">Importation & Exportation</span>
          </div>
        </div>
      </a>

      <!-- Right side: language + CTA -->
      <div class="flex items-center gap-4">
        <!-- Language toggle -->
        <div class="flex items-center rounded border border-gray-300 overflow-hidden text-xs font-semibold">
          <button id="btn-pt" onclick="setLang('pt')" class="px-3 py-2 transition-colors text-gray-500 hover:bg-gray-100">PT</button>
          <span class="text-gray-300">|</span>
          <button id="btn-en" onclick="setLang('en')" class="px-3 py-2 transition-colors text-gray-500 hover:bg-gray-100">EN</button>
          <span class="text-gray-300">|</span>
          <button id="btn-fr" onclick="setLang('fr')" class="px-3 py-2 transition-colors text-gray-500 hover:bg-gray-100">FR</button>

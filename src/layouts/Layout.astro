          <ul class="space-y-2 text-sm">
            <li><a href="/shop?cat=dairy" class="hover:text-white transition-colors"><span class="lang-pt">Laticínios</span><span class="lang-en">Dairy</span><span class="lang-fr">Produits Laitiers</span></a></li>
            <li><a href="/shop?cat=supplements" class="hover:text-white transition-colors"><span class="lang-pt">Suplementos</span><span class="lang-en">Supplements</span><span class="lang-fr">Compléments</span></a></li>
            <li><a href="/shop?cat=hygiene" class="hover:text-white transition-colors"><span class="lang-pt">Higiene</span><span class="lang-en">Hygiene</span><span class="lang-fr">Hygiène</span></a></li>
            <li><a href="/shop?cat=industrial" class="hover:text-white transition-colors"><span class="lang-pt">Industrial</span><span class="lang-en">Industrial</span><span class="lang-fr">Industriel</span></a></li>
            <li><a href="/shop?cat=cleaning" class="hover:text-white transition-colors"><span class="lang-pt">Limpeza</span><span class="lang-en">Cleaning</span><span class="lang-fr">Nettoyage</span></a></li>
            <li><a href="/shop?cat=petfood" class="hover:text-white transition-colors"><span class="lang-pt">Alimentos Pet</span><span class="lang-en">Pet Food</span><span class="lang-fr">Alimentation Animale</span></a></li>
          </ul>
        </div>

        <!-- Contact Us -->
        <div>
          <h4 class="font-display font-bold text-white text-xs uppercase tracking-widest mb-3 border-b border-verma-red pb-2">

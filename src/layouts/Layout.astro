---
const { title = 'B3 Global', description = 'B3 Global Importação e Exportação — Produtos brasileiros premium exportados para o mundo.' } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(path) {
  if (path === '/' ) return currentPath === '/';
  return currentPath.startsWith(path);
}
---
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — B3 Global</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Language init — runs before paint to avoid flash -->
  <script is:inline>
    (function() {
      var lang = localStorage.getItem('b3lang') || 'pt';
      document.documentElement.setAttribute('data-lang', lang);
    })();
  </script>

  <style is:inline>
    [data-lang="pt"] .lang-en { display: none !important; }
    [data-lang="pt"] .lang-fr { display: none !important; }
    [data-lang="en"] .lang-fr { display: none !important; }
    [data-lang="fr"] .lang-pt { display: none !important; }
    [data-lang="fr"] .lang-en { display: none !important; }
    [data-lang="en"] .lang-pt { display: none !important; }
  </style>
</head>
<body class="bg-white font-sans text-gray-800 antialiased">

  <!-- TOP INFO BAR -->
  <div class="bg-white border-b border-gray-200 text-xs py-2 hidden sm:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-6 text-gray-500">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-verma-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="lang-pt">Brasil (Principal) · EUA · Canadá</span>
          <span class="lang-en">Brazil (Main) · USA · Canada</span>
          <span class="lang-fr">Brésil (Principal) · États-Unis · Canada</span>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-verma-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          info@b3globalimportacaoeexporta.com.br
        </span>
      </div>
      <a href="https://wa.me/5511953954562" class="flex items-center gap-1.5 text-verma-green font-medium hover:opacity-80 transition-opacity">
        <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.025.507 3.934 1.401 5.605L0 24l6.604-1.375A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-4.868-1.292l-.35-.208-3.621.754.766-3.53-.228-.362A9.818 9.818 0 1112 21.818z"/></svg>
        WhatsApp: +55 11 95395-4562
      </a>

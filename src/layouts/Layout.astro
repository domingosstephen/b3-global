        <a href="/shop" class={`px-5 py-3 text-sm font-semibold uppercase tracking-wide transition-colors border-b-2 ${isActive('/shop') ? 'text-gold-500 border-gold-500' : 'text-white border-transparent hover:text-gold-400 hover:border-gold-400'}`}>

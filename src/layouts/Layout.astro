          <span class="lang-en">Contact</span>
          <span class="lang-fr">Contact</span>
        </a>
      </nav>

      <!-- Mobile nav placeholder row -->
      <div class="md:hidden flex items-center justify-between h-12">
        <span class="text-white text-sm font-semibold uppercase tracking-wide">Menu</span>
        <button id="mobile-nav-btn" class="text-white p-1" aria-label="Toggle menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-verma-darker">
      <div class="px-4 py-3 space-y-0.5">
        <a href="/" class="block px-4 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:bg-white/10 rounded">
          <span class="lang-pt">Início</span><span class="lang-en">Home</span><span class="lang-fr">Accueil</span>
        </a>
        <a href="/shop" class="block px-4 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:bg-white/10 rounded">
          <span class="lang-pt">Produtos</span><span class="lang-en">Products</span><span class="lang-fr">Produits</span>
        </a>
        <a href="/about" class="block px-4 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:bg-white/10 rounded">
          <span class="lang-pt">Sobre</span><span class="lang-en">About Us</span><span class="lang-fr">À Propos</span>
        </a>
        <a href="/contact" class="block px-4 py-2.5 text-sm font-semibold uppercase tracking-wide text-white hover:bg-white/10 rounded">
          <span class="lang-pt">Contato</span><span class="lang-en">Contact</span><span class="lang-fr">Contact</span>
        </a>
        <a href="/contact" class="block mt-2 bg-verma-green text-white font-bold text-sm px-4 py-2.5 rounded text-center uppercase tracking-wide">
          <span class="lang-pt">Solicitar Cotação</span><span class="lang-en">Get a Quote</span><span class="lang-fr">Demander un Devis</span>
        </a>
      </div>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <main>
    <slot />
  </main>

  <!-- FOOTER SUPPORT STRIP -->

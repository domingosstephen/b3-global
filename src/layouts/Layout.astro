  <script is:inline>
    // Language system
    function setLang(lang) {
      localStorage.setItem('b3lang', lang);
      document.documentElement.setAttribute('data-lang', lang);
      updateLangBtns(lang);
    }

    function updateLangBtns(lang) {
      var btns = { pt: document.getElementById('btn-pt'), en: document.getElementById('btn-en'), fr: document.getElementById('btn-fr') };
      for (var k in btns) {
        if (btns[k]) {
          btns[k].style.color = k === lang ? '#F6AC06' : '';
          btns[k].style.fontWeight = k === lang ? '700' : '';
        }
      }
    }

    // Init
    (function() {
      var lang = document.documentElement.getAttribute('data-lang') || 'pt';
      updateLangBtns(lang);
    })();

    // Mobile menu (nav bar)
    var mobileNavBtn = document.getElementById('mobile-nav-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    if (mobileNavBtn && mobileMenu) {
      mobileNavBtn.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/15">
        <!-- 24/7 Support -->
        <div class="flex items-center gap-5 px-6 py-4 sm:py-0">
          <div class="w-12 h-12 rounded-full border-2 border-gold-500 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="font-display font-bold text-white text-sm uppercase tracking-wide">24/7 SUPPORT</div>
            <div class="text-gray-400 text-xs mt-0.5">
              <span class="lang-pt">Sempre disponível para você</span>
              <span class="lang-en">Always available for you</span>
              <span class="lang-fr">Toujours disponible pour vous</span>
            </div>
          </div>
        </div>
        <!-- Free Shipping -->
        <div class="flex items-center gap-5 px-6 py-4 sm:py-0">
          <div class="w-12 h-12 rounded-full border-2 border-gold-500 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <div>
            <div class="font-display font-bold text-white text-sm uppercase tracking-wide">
              <span class="lang-pt">ENTREGA MUNDIAL</span>
              <span class="lang-en">FREE SHIPPING</span>
              <span class="lang-fr">LIVRAISON MONDIALE</span>
            </div>
            <div class="text-gray-400 text-xs mt-0.5">
              <span class="lang-pt">Entrega via DHL para todo o mundo</span>
              <span class="lang-en">DHL delivery to any country</span>
              <span class="lang-fr">Livraison DHL dans le monde entier</span>
            </div>
          </div>
        </div>
        <!-- Money Back -->
        <div class="flex items-center gap-5 px-6 py-4 sm:py-0">
          <div class="w-12 h-12 rounded-full border-2 border-gold-500 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div>
            <div class="font-display font-bold text-white text-sm uppercase tracking-wide">MONEY BACK</div>
            <div class="text-gray-400 text-xs mt-0.5">
              <span class="lang-pt">Garantia 100% de satisfação</span>
              <span class="lang-en">100% Money-Back Guarantee</span>
              <span class="lang-fr">Garantie satisfait ou remboursé</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER COLUMNS -->
  <footer class="bg-verma-darker text-gray-400 pt-14 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-10 border-b border-white/10">

        <!-- Company Detail -->
        <div class="sm:col-span-2 lg:col-span-1">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-11 h-11 rounded-lg bg-verma-dark border border-gold-500/30 flex items-center justify-center font-display font-bold text-gold-500 text-base">B3</div>
            <div>
              <div class="font-display font-bold text-white text-lg">B3 Global</div>
              <div class="text-gold-500 text-[10px] tracking-[0.2em] uppercase font-medium">
                <span class="lang-pt">Importação & Exportação</span>
                <span class="lang-en">Import & Export</span>
                <span class="lang-fr">Importation & Exportation</span>
              </div>
            </div>
          </div>
          <h4 class="font-display font-bold text-white text-xs uppercase tracking-widest mb-3 border-b border-verma-red pb-2">
            <span class="lang-pt">DETALHE DA EMPRESA</span>
            <span class="lang-en">COMPANY DETAIL</span>
            <span class="lang-fr">DÉTAIL DE L'ENTREPRISE</span>
          </h4>
          <p class="text-sm leading-relaxed mb-3">
            <span class="lang-pt">Conectamos os melhores produtos brasileiros ao mundo desde 2006. Envios do Brasil, com filiais nos EUA e Canadá.</span>
            <span class="lang-en">Connecting the finest Brazilian products to the world since 2006. Shipments from Brazil, with subsidiaries in the USA and Canada.</span>

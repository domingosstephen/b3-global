        <a href="/about" class={`px-5 py-3 text-sm font-semibold uppercase tracking-wide transition-colors border-b-2 ${isActive('/about') ? 'text-gold-500 border-gold-500' : 'text-white border-transparent hover:text-gold-400 hover:border-gold-400'}`}>
          <span class="lang-pt">Sobre</span>
          <span class="lang-en">About Us</span>
          <span class="lang-fr">À Propos</span>
        </a>
        <a href="/contact" class={`px-5 py-3 text-sm font-semibold uppercase tracking-wide transition-colors border-b-2 ${isActive('/contact') ? 'text-gold-500 border-gold-500' : 'text-white border-transparent hover:text-gold-400 hover:border-gold-400'}`}>

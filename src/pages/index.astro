---
import Layout from '../layouts/Layout.astro';
import { products, categories, categoryIcons, featuredIds } from '../data/products.js';

const featured = products.filter(p => featuredIds.includes(p.id));
---
<Layout title="Início" description="B3 Global — Importação e exportação de produtos brasileiros premium para o mundo. Fundada em 2006.">

  <!-- HERO -->
  <section class="relative bg-navy-950 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-gold-500/5 blur-3xl"></div>
      <div class="absolute bottom-0 -left-32 w-96 h-96 rounded-full bg-blue-500/5 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 md:py-40 text-center">
      <div class="inline-flex items-center gap-2 bg-gold-500/10 border border-gold-500/30 rounded-full px-4 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse"></span>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">
          <span class="lang-pt">Importação & Exportação Global</span>
          <span class="lang-en">Global Import & Export</span>
          <span class="lang-fr">Importation & Exportation Mondiale</span>
        </span>
      </div>
      <h1 class="font-display font-extrabold text-5xl sm:text-6xl md:text-7xl text-white mb-6 tracking-tight leading-none">
        B3 <span class="text-gold-500">Global</span>
      </h1>
      <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
        <span class="lang-pt">Conectando os melhores produtos brasileiros ao Brasil e ao mundo. Qualidade premium, entrega internacional confiável.</span>
        <span class="lang-en">Connecting the finest Brazilian products to the world. Premium quality, reliable international delivery.</span>
        <span class="lang-fr">Connecter les meilleurs produits brésiliens au monde. Qualité premium, livraison internationale fiable.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/shop" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold text-base px-8 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gold-500/20">
          <span class="lang-pt">Ver Produtos</span>
          <span class="lang-en">Browse Products</span>
          <span class="lang-fr">Voir les Produits</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/about" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/20 hover:border-white/40 text-white font-semibold text-base px-8 py-3.5 rounded-xl transition-all">
          <span class="lang-pt">Sobre Nós</span>
          <span class="lang-en">About Us</span>
          <span class="lang-fr">À Propos</span>
        </a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-navy-900 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
        {[
          { num: '150+', label_pt: 'Produtos', label_en: 'Products', label_fr: 'Produits', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>` },
          { num: '10',   label_pt: 'Categorias', label_en: 'Categories', label_fr: 'Catégories', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>` },
          { num: 'DHL',  label_pt: 'Entrega Mundial', label_en: 'Worldwide Delivery', label_fr: 'Livraison Mondiale', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>` },
          { num: '2006', label_pt: 'Ano de Fundação', label_en: 'Year Founded', label_fr: 'Année de Fondation', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>` },
        ].map(s => (
          <div class="flex flex-col items-center justify-center py-8 px-4 gap-2 text-center">
            <svg class="w-5 h-5 text-gold-500/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={s.icon}></svg>
            <span class="font-display font-extrabold text-2xl text-gold-500">{s.num}</span>
            <span class="text-slate-400 text-xs">
              <span class="lang-pt">{s.label_pt}</span>
              <span class="lang-en">{s.label_en}</span>
              <span class="lang-fr">{s.label_fr}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-navy-900 mb-3">
          <span class="lang-pt">Nossas Categorias</span>
          <span class="lang-en">Our Categories</span>
          <span class="lang-fr">Nos Catégories</span>
        </h2>
        <p class="text-slate-500 max-w-xl mx-auto">
          <span class="lang-pt">Amplo portfólio de produtos brasileiros premium para importação e exportação</span>
          <span class="lang-en">A broad portfolio of premium Brazilian products for import and export</span>
          <span class="lang-fr">Un large portefeuille de produits brésiliens premium pour l'importation et l'exportation</span>
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {categories.map(cat => (
          <a href={`/shop?cat=${cat.id}`}
             class="group flex flex-col items-center gap-3 p-5 bg-white rounded-2xl border border-slate-200 hover:border-gold-400 hover:shadow-lg hover:shadow-gold-500/10 transition-all hover:-translate-y-1 text-center">
            <div class="w-12 h-12 rounded-xl bg-navy-900 group-hover:bg-gold-500 flex items-center justify-center transition-colors">
              <svg class="w-6 h-6 text-gold-400 group-hover:text-navy-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[cat.id]}></svg>
            </div>
            <span class="font-semibold text-sm text-navy-800 group-hover:text-gold-600 transition-colors leading-tight">
              <span class="lang-pt">{cat.label_pt}</span>
              <span class="lang-en">{cat.label_en}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-navy-900 mb-2">
            <span class="lang-pt">Produtos em Destaque</span>
            <span class="lang-en">Featured Products</span>
            <span class="lang-fr">Produits en Vedette</span>
          </h2>
          <p class="text-slate-500">
            <span class="lang-pt">Seleção dos produtos mais procurados</span>
            <span class="lang-en">Our most sought-after product selection</span>
          </p>
        </div>
        <a href="/shop" class="shrink-0 inline-flex items-center gap-1.5 text-gold-600 hover:text-gold-700 font-semibold text-sm transition-colors">
          <span class="lang-pt">Ver todos</span>
          <span class="lang-en">View all</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {featured.map(p => {
          const cat = categories.find(c => c.id === p.category);
          return (
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:shadow-slate-200 hover:-translate-y-1 transition-all">
              <div class="relative h-48 bg-slate-100 overflow-hidden">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.style.display='none';this.parentElement.classList.add('flex','items-center','justify-center');this.parentElement.innerHTML+='<svg class=\'w-12 h-12 text-slate-300\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'/></svg>'"
                />
                <div class="absolute top-2 right-2">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[9px] font-semibold bg-navy-900/80 text-gold-400 uppercase tracking-wide">
                    <span class="lang-pt">{cat?.label_pt}</span>
                    <span class="lang-en">{cat?.label_en}</span>
                  </span>
                </div>
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-navy-900 text-sm leading-snug mb-3 min-h-[2.5rem] line-clamp-2">{p.name}</h3>
                <a href="/contact" class="flex items-center justify-center gap-1.5 w-full bg-navy-900 hover:bg-gold-500 text-white hover:text-navy-900 font-semibold text-xs py-2.5 rounded-xl transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="lang-pt">Solicitar Cotação</span>
                  <span class="lang-en">Request Quote</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="py-20 bg-navy-950 text-white overflow-hidden relative">
    <div class="absolute right-0 top-0 w-72 h-72 rounded-full bg-gold-500/5 blur-3xl pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-14 items-center">
        <div>
          <div class="inline-block bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold tracking-widest uppercase px-3 py-1 rounded-full mb-5">
            <span class="lang-pt">Sobre a Empresa</span>
            <span class="lang-en">About the Company</span>
          </div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-5 leading-tight">
            <span class="lang-pt">Sua Parceira Global de Importação e Exportação</span>
            <span class="lang-en">Your Global Import & Export Partner</span>
          </h2>
          <p class="text-slate-300 leading-relaxed mb-6">
            <span class="lang-pt">A B3 Global nasceu com um propósito claro: exportar os melhores produtos brasileiros para o mundo. Com base no Brasil e filiais nos EUA e Canadá, oferecemos qualidade, confiança e excelência em cada transação.</span>
            <span class="lang-en">B3 Global was born with a clear purpose: to export the finest Brazilian products to the world. Based in Brazil with subsidiaries in the USA and Canada, we offer quality, trust, and excellence in every transaction.</span>
            <span class="lang-fr">B3 Global est née pour exporter les meilleurs produits brésiliens dans le monde entier. Basée au Brésil avec des filiales aux États-Unis et au Canada, nous offrons qualité, confiance et excellence.</span>
          </p>
          <ul class="space-y-2.5 mb-8">
            {[
              { pt: '6.000+ marcas reconhecidas', en: '6,000+ recognized brands' },
              { pt: 'Entrega internacional via DHL', en: 'DHL international delivery' },
              { pt: 'Suporte 24/7 multilíngue', en: '24/7 multilingual support' },
              { pt: 'Garantia 100% satisfação', en: '100% satisfaction guarantee' },
            ].map(item => (
              <li class="flex items-center gap-2.5 text-sm">
                <svg class="w-4 h-4 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span class="text-slate-300">
                  <span class="lang-pt">{item.pt}</span>
                  <span class="lang-en">{item.en}</span>
                </span>
              </li>
            ))}
          </ul>
          <a href="/about" class="inline-flex items-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold text-sm px-6 py-3 rounded-xl transition-all hover:-translate-y-0.5">
            <span class="lang-pt">Saiba Mais</span>
            <span class="lang-en">Learn More</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`, pt: 'Entrega Mundial', en: 'Worldwide Delivery', desc_pt: 'Enviamos para qualquer país do mundo', desc_en: 'We ship to any country worldwide' },
            { icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`, pt: 'Garantia Total', en: 'Full Guarantee', desc_pt: '100% de satisfação ou devolução', desc_en: '100% satisfaction or money back' },
            { icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>`, pt: 'Preço Justo', en: 'Fair Pricing', desc_pt: 'Melhor preço com qualidade premium', desc_en: 'Best price with premium quality' },
            { icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>`, pt: 'Embalagem Segura', en: 'Safe Packaging', desc_pt: 'Produtos protegidos para entrega perfeita', desc_en: 'Products protected for perfect delivery' },
          ].map(b => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 hover:bg-white/10 transition-colors">
              <svg class="w-7 h-7 text-gold-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={b.icon}></svg>
              <h4 class="font-display font-semibold text-white text-sm mb-1">
                <span class="lang-pt">{b.pt}</span>
                <span class="lang-en">{b.en}</span>
              </h4>
              <p class="text-slate-400 text-xs leading-relaxed">
                <span class="lang-pt">{b.desc_pt}</span>
                <span class="lang-en">{b.desc_en}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-navy-900 mb-3">
          <span class="lang-pt">O Que Dizem Nossos Clientes</span>
          <span class="lang-en">What Our Clients Say</span>
        </h2>
        <p class="text-slate-500">
          <span class="lang-pt">Confiança construída através de anos de excelência</span>
          <span class="lang-en">Trust built through years of excellence</span>
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { name: 'Carlos M.', role_pt: 'Importador, São Paulo', role_en: 'Importer, São Paulo', text_pt: 'Excelente parceiro comercial. Produtos de alta qualidade, entrega pontual e suporte impecável. Recomendo fortemente.', text_en: 'Excellent business partner. High-quality products, on-time delivery, and impeccable support. Highly recommended.' },
          { name: 'Ana Lima', role_pt: 'Distribuidora, Rio de Janeiro', role_en: 'Distributor, Rio de Janeiro', text_pt: 'Trabalho com a B3 Global há anos. Sempre cumprem o que prometem. Embalagem cuidadosa e produtos autênticos.', text_en: "I've worked with B3 Global for years. They always deliver on their promises. Careful packaging and authentic products." },
          { name: 'Roberto F.', role_pt: 'Atacadista, Curitiba', role_en: 'Wholesaler, Curitiba', text_pt: 'Preços competitivos e variedade impressionante de produtos brasileiros. Meu fornecedor preferido para exportações.', text_en: 'Competitive prices and an impressive variety of Brazilian products. My preferred supplier for exports.' },
          { name: 'Mariana S.', role_pt: 'Empresária, Belo Horizonte', role_en: 'Business Owner, BH', text_pt: 'Atendimento rápido e profissional. Os produtos chegaram perfeitos e dentro do prazo. Voltarei a comprar com certeza.', text_en: 'Fast and professional service. Products arrived perfectly and on time. I will definitely buy again.' },
        ].map(t => (
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col">
            <!-- Quote icon -->
            <svg class="w-6 h-6 text-gold-400 mb-3" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
            <p class="text-slate-600 text-sm leading-relaxed flex-1 mb-5">
              <span class="lang-pt">{t.text_pt}</span>
              <span class="lang-en">{t.text_en}</span>
            </p>
            <div class="flex items-center gap-3 border-t border-slate-100 pt-4">
              <div class="w-9 h-9 rounded-full bg-navy-900 flex items-center justify-center font-display font-bold text-gold-400 text-xs shrink-0">
                {t.name.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <div class="font-semibold text-navy-900 text-sm">{t.name}</div>
                <div class="text-slate-500 text-xs">
                  <span class="lang-pt">{t.role_pt}</span>
                  <span class="lang-en">{t.role_en}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="py-16 bg-gold-500">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-display font-extrabold text-3xl md:text-4xl text-navy-900 mb-4">
        <span class="lang-pt">Pronto para Importar com Qualidade?</span>
        <span class="lang-en">Ready to Import with Quality?</span>
      </h2>
      <p class="text-navy-800 text-base mb-8 max-w-xl mx-auto">
        <span class="lang-pt">Entre em contato e receba uma cotação personalizada para os produtos que você precisa.</span>
        <span class="lang-en">Get in touch and receive a personalized quote for the products you need.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-navy-900 hover:bg-navy-800 text-white font-bold text-base px-8 py-3.5 rounded-xl transition-all hover:-translate-y-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="lang-pt">Solicitar Cotação</span>
          <span class="lang-en">Request a Quote</span>
        </a>
        <a href="/shop" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/30 hover:bg-white/50 text-navy-900 font-semibold text-base px-8 py-3.5 rounded-xl transition-all">
          <span class="lang-pt">Ver Catálogo</span>
          <span class="lang-en">View Catalog</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

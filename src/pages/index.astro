---
import Layout from '../layouts/Layout.astro';
import { products, categories, categoryIcons, featuredIds } from '../data/products.js';

const featured = products.filter(p => featuredIds.includes(p.id));
---
<Layout title="Início" description="B3 Global — Importação e exportação de produtos brasileiros premium para o mundo. Fundada em 2006.">

  <!-- HERO (full-bleed slider-style, bg image + dark overlay) -->
  <section class="relative h-[500px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://vermagmbh.com/wp-content/uploads/2022/09/wp2004328-cosmetics-wallpapers.jpg"
        alt=""
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0" style="background-color:#00000085;"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl text-white mb-5 uppercase tracking-tight leading-tight">
        WELCOME TO <span style="color:#F6AC06;">B3 GLOBAL</span>
      </h1>
      <p class="text-gray-200 text-base md:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
        <span class="lang-pt">Conectando os melhores produtos brasileiros ao mundo desde 2006. Qualidade premium, entrega internacional confiável.</span>
        <span class="lang-en">Connecting the finest Brazilian products to the world since 2006. Premium quality, reliable international delivery.</span>
        <span class="lang-fr">Les meilleurs produits brésiliens au monde depuis 2006. Qualité premium, livraison internationale fiable.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/about" class="w-full sm:w-auto inline-flex items-center justify-center font-bold text-sm uppercase tracking-widest px-8 py-3.5 rounded transition-all" style="background-color:#2D3A4B; color:white;">
          <span class="lang-pt">Saiba Mais</span>
          <span class="lang-en">KNOW MORE ABOUT US</span>
          <span class="lang-fr">EN SAVOIR PLUS</span>
        </a>
        <a href="/shop" class="w-full sm:w-auto inline-flex items-center justify-center font-bold text-sm uppercase tracking-widest px-8 py-3.5 rounded transition-all" style="background-color:#2E8D08; color:white;">
          <span class="lang-pt">VER PRODUTOS</span>
          <span class="lang-en">START SHOPPING NOW</span>
          <span class="lang-fr">VOIR LES PRODUITS</span>
        </a>
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center font-bold text-sm uppercase tracking-widest px-8 py-3.5 rounded transition-all border border-white/40 text-white hover:bg-white/10">
          <span class="lang-pt">CONTATO</span>
          <span class="lang-en">CONTACT US</span>
          <span class="lang-fr">CONTACTEZ-NOUS</span>
        </a>
      </div>
    </div>
  </section>

  <!-- OUR CATEGORIES -->
  <section class="py-14" style="background-color:#f5f5f5;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl uppercase mb-3" style="color:#041121;">
          <span class="lang-pt">NOSSAS CATEGORIAS</span>
          <span class="lang-en">OUR CATEGORIES</span>
          <span class="lang-fr">NOS CATÉGORIES</span>
        </h2>
        <div class="w-16 h-1 mx-auto" style="background-color:#FC0303;"></div>
        <p class="text-gray-500 mt-4 text-sm max-w-xl mx-auto">
          <span class="lang-pt">Amplo portfólio de produtos brasileiros premium para importação e exportação</span>
          <span class="lang-en">A broad portfolio of premium Brazilian products for import and export</span>
          <span class="lang-fr">Un large portefeuille de produits brésiliens premium pour l'importation et l'exportation</span>
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {categories.map(cat => (
          <a href={`/shop?cat=${cat.id}`}
             class="group flex flex-col items-center gap-3 p-5 bg-white rounded-lg border border-gray-200 hover:border-gray-400 hover:shadow-md transition-all text-center">
            <div class="w-12 h-12 rounded flex items-center justify-center transition-colors" style="background-color:#2D3A4B;">
              <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[cat.id]}></svg>
            </div>
            <span class="font-semibold text-sm leading-tight transition-colors" style="color:#2D3A4B;">
              <span class="lang-pt">{cat.label_pt}</span>
              <span class="lang-en">{cat.label_en}</span>
              <span class="lang-fr">{cat.label_fr}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER (bg image + dark overlay, "PLACE YOUR ORDER TODAY") -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://vermagmbh.com/wp-content/uploads/2022/09/banner2-1.jpg"
        alt=""
        class="w-full h-full object-cover object-center"
        onerror="this.src='https://vermagmbh.com/wp-content/uploads/2022/09/wp2004328-cosmetics-wallpapers.jpg'"
      />
      <div class="absolute inset-0" style="background-color:#00000085;"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl md:text-5xl text-white uppercase leading-tight mb-6 tracking-tight">
        <span class="lang-pt">" FAÇA SEU PEDIDO HOJE E APROVEITE NOSSO PLANO DE DESCONTOS CONTÍNUO "</span>
        <span class="lang-en">" PLACE YOUR ORDER TODAY AND ENJOY FROM OUR ONGOING DISCOUNT PLAN "</span>
        <span class="lang-fr">" PASSEZ VOTRE COMMANDE AUJOURD'HUI ET PROFITEZ DE NOTRE PLAN DE REMISES EN COURS "</span>
      </h2>
      <p class="text-gray-300 text-base mb-8 max-w-2xl mx-auto">
        <span class="lang-pt">Produtos brasileiros premium com preços competitivos e entrega via DHL rastreada para qualquer lugar do mundo.</span>
        <span class="lang-en">Premium Brazilian products at competitive prices with tracked DHL delivery anywhere in the world.</span>
        <span class="lang-fr">Produits brésiliens premium à des prix compétitifs avec livraison DHL suivie partout dans le monde.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center font-bold text-sm uppercase tracking-widest px-8 py-3.5 rounded transition-all" style="background-color:#BA1404; color:white;">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="lang-pt">SOLICITAR COTAÇÃO</span>
          <span class="lang-en">REQUEST A QUOTE</span>
          <span class="lang-fr">DEMANDER UN DEVIS</span>
        </a>
        <a href="/shop" class="w-full sm:w-auto inline-flex items-center justify-center font-bold text-sm uppercase tracking-widest px-8 py-3.5 rounded transition-all" style="background-color:#2E8D08; color:white;">
          <span class="lang-pt">VER CATÁLOGO</span>
          <span class="lang-en">BROWSE CATALOG</span>
          <span class="lang-fr">VOIR LE CATALOGUE</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl uppercase mb-3" style="color:#041121;">
          <span class="lang-pt">Oferecemos os seguintes benefícios</span>
          <span class="lang-en">We provide you the following benefits</span>
          <span class="lang-fr">Nous vous offrons les avantages suivants</span>
        </h2>
        <div class="w-16 h-1 mx-auto" style="background-color:#FC0303;"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
            pt: 'Entrega Mundial', en: 'Worldwide Delivery', fr: 'Livraison Mondiale',
            desc_pt: 'Enviamos para qualquer país do mundo com rastreamento completo.', desc_en: 'We ship to any country in the world with full tracking.', desc_fr: 'Nous livrons dans n\'importe quel pays avec un suivi complet.'
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>`,
            pt: 'Ofertas Semanais', en: 'Weekly Deals', fr: 'Offres Hebdomadaires',
            desc_pt: 'Promoções exclusivas toda semana nos melhores produtos brasileiros.', desc_en: 'Exclusive promotions every week on the best Brazilian products.', desc_fr: 'Promotions exclusives chaque semaine sur les meilleurs produits brésiliens.'
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>`,
            pt: 'Marcas Premium', en: 'Premium Brands', fr: 'Marques Premium',
            desc_pt: 'Mais de 150 produtos das melhores marcas brasileiras.', desc_en: 'Over 150 products from the best Brazilian brands.', desc_fr: 'Plus de 150 produits des meilleures marques brésiliennes.'
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>`,
            pt: 'Preço Competitivo', en: 'Fair Pricing', fr: 'Prix Compétitifs',
            desc_pt: 'Cotações personalizadas com o melhor custo-benefício do mercado.', desc_en: 'Custom quotes with the best value in the market.', desc_fr: 'Devis personnalisés avec le meilleur rapport qualité-prix.'
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>`,
            pt: 'Entrega DHL', en: 'DHL Shipping', fr: 'Livraison DHL',
            desc_pt: 'Entrega expressa DHL com rastreamento em tempo real.', desc_en: 'DHL express delivery with real-time tracking.', desc_fr: 'Livraison DHL express avec suivi en temps réel.'
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>`,
            pt: 'Suporte Multilíngue', en: 'Multilingual Support', fr: 'Support Multilingue',
            desc_pt: 'Atendimento dedicado em Português, Inglês e Francês.', desc_en: 'Dedicated service in Portuguese, English and French.', desc_fr: 'Service dédié en Portugais, Anglais et Français.'
          },
        ].map(b => (
          <div class="flex items-start gap-4 p-5 rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-sm transition-all bg-white">
            <div class="w-12 h-12 rounded flex items-center justify-center shrink-0" style="background-color:#2D3A4B;">
              <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={b.icon}></svg>
            </div>
            <div>
              <h4 class="font-display font-bold text-sm uppercase mb-1" style="color:#2D3A4B;">
                <span class="lang-pt">{b.pt}</span>
                <span class="lang-en">{b.en}</span>
                <span class="lang-fr">{b.fr}</span>
              </h4>
              <p class="text-gray-500 text-xs leading-relaxed">
                <span class="lang-pt">{b.desc_pt}</span>
                <span class="lang-en">{b.desc_en}</span>
                <span class="lang-fr">{b.desc_fr}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- READY FOR ORDER / FEATURED PRODUCTS -->
  <section class="py-14" style="background-color:#f5f5f5;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="font-display font-extrabold text-2xl md:text-3xl uppercase mb-2" style="color:#041121;">
            <span class="lang-pt">PRONTO PARA PEDIDO</span>
            <span class="lang-en">READY FOR ORDER</span>
            <span class="lang-fr">PRÊT À COMMANDER</span>
          </h2>
          <div class="w-16 h-1" style="background-color:#FC0303;"></div>
        </div>
        <a href="/shop" class="shrink-0 inline-flex items-center gap-1.5 font-bold text-sm uppercase tracking-wide transition-all px-5 py-2 rounded" style="background-color:#BA1404; color:white;">
          <span class="lang-pt">Ver Todos</span>
          <span class="lang-en">View All Products</span>
          <span class="lang-fr">Voir Tout</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
        {featured.map(p => {
          const cat = categories.find(c => c.id === p.category);
          return (
            <div class="group bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all">
              <div class="relative h-48 bg-gray-100 overflow-hidden">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.style.display='none';this.parentElement.classList.add('flex','items-center','justify-center');this.parentElement.innerHTML+='<svg class=\'w-12 h-12 text-gray-300\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'/></svg>'"
                />
                <div class="absolute top-2 right-2">
                  <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wide text-white" style="background-color:#2D3A4B;">
                    <span class="lang-pt">{cat?.label_pt}</span>
                    <span class="lang-en">{cat?.label_en}</span>
                    <span class="lang-fr">{cat?.label_fr}</span>
                  </span>
                </div>
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-sm leading-snug mb-1 min-h-[2.5rem] line-clamp-2" style="color:#2D3A4B;">{p.name}</h3>
                <p class="text-xs text-gray-400 mb-3">
                  <span class="lang-pt">{cat?.label_pt}</span>
                  <span class="lang-en">{cat?.label_en}</span>
                  <span class="lang-fr">{cat?.label_fr}</span>
                </p>
                <a href="/contact" class="flex items-center justify-center gap-1.5 w-full text-white font-bold text-xs py-2.5 rounded transition-all uppercase tracking-wide" style="background-color:#376F20;">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="lang-pt">Solicitar Cotação</span>
                  <span class="lang-en">Request Quote</span>
                  <span class="lang-fr">Demander un Devis</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CLIENTS REVIEWS (dark bg with image overlay) -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://vermagmbh.com/wp-content/uploads/2022/09/back1-1-scaled-1.jpg"
        alt=""
        class="w-full h-full object-cover object-center"
        onerror="this.parentElement.style.backgroundColor='#041121';"
      />
      <div class="absolute inset-0" style="background-color:#000000cc;"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-white uppercase mb-3">
          <span class="lang-pt">AVALIAÇÕES DE CLIENTES</span>
          <span class="lang-en">CLIENTS REVIEWS</span>
          <span class="lang-fr">AVIS DE CLIENTS</span>
        </h2>
        <div class="w-16 h-1 mx-auto" style="background-color:#FC0303;"></div>
        <p class="text-gray-300 text-sm mt-4">
          <span class="lang-pt">Confiança construída através de anos de excelência</span>
          <span class="lang-en">Trust built through years of excellence</span>
          <span class="lang-fr">La confiance construite au fil des années d'excellence</span>
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { name: 'Carlos M.', role_pt: 'Importador, São Paulo', role_en: 'Importer, São Paulo', role_fr: 'Importateur, São Paulo', text_pt: 'Excelente parceiro comercial. Produtos de alta qualidade, entrega pontual e suporte impecável. Recomendo fortemente.', text_en: 'Excellent business partner. High-quality products, on-time delivery, and impeccable support. Highly recommended.', text_fr: 'Excellent partenaire commercial. Produits de haute qualité, livraison ponctuelle et support impeccable. Je recommande vivement.' },
          { name: 'Ana Lima', role_pt: 'Distribuidora, Rio de Janeiro', role_en: 'Distributor, Rio de Janeiro', role_fr: 'Distributrice, Rio de Janeiro', text_pt: 'Trabalho com a B3 Global há anos. Sempre cumprem o que prometem. Embalagem cuidadosa e produtos autênticos.', text_en: "I've worked with B3 Global for years. They always deliver on their promises. Careful packaging and authentic products.", text_fr: "Je travaille avec B3 Global depuis des années. Ils tiennent toujours leurs promesses. Emballage soigné et produits authentiques." },
          { name: 'Roberto F.', role_pt: 'Atacadista, Curitiba', role_en: 'Wholesaler, Curitiba', role_fr: 'Grossiste, Curitiba', text_pt: 'Preços competitivos e variedade impressionante de produtos brasileiros. Meu fornecedor preferido para exportações.', text_en: 'Competitive prices and an impressive variety of Brazilian products. My preferred supplier for exports.', text_fr: 'Prix compétitifs et variété impressionnante de produits brésiliens. Mon fournisseur préféré pour les exportations.' },
          { name: 'Mariana S.', role_pt: 'Empresária, Belo Horizonte', role_en: 'Business Owner, BH', role_fr: "Cheffe d'entreprise, BH", text_pt: 'Atendimento rápido e profissional. Os produtos chegaram perfeitos e dentro do prazo. Voltarei a comprar com certeza.', text_en: 'Fast and professional service. Products arrived perfectly and on time. I will definitely buy again.', text_fr: 'Service rapide et professionnel. Les produits sont arrivés parfaits et dans les délais. Je rachèterai certainement.' },
        ].map(t => (
          <div class="rounded-lg p-6 flex flex-col" style="background-color:#2D3A4B;">
            <svg class="w-7 h-7 mb-3" fill="currentColor" style="color:#F6AC06;" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
            <p class="text-gray-300 text-sm leading-relaxed flex-1 mb-5">
              <span class="lang-pt">{t.text_pt}</span>
              <span class="lang-en">{t.text_en}</span>
              <span class="lang-fr">{t.text_fr}</span>
            </p>
            <div class="flex items-center gap-3 border-t border-white/10 pt-4">
              <div class="w-9 h-9 rounded-full flex items-center justify-center font-display font-bold text-xs shrink-0" style="background-color:#F6AC06; color:#041121;">
                {t.name.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <div class="font-bold text-white text-sm">{t.name}</div>
                <div class="text-gray-400 text-xs">
                  <span class="lang-pt">{t.role_pt}</span>
                  <span class="lang-en">{t.role_en}</span>
                  <span class="lang-fr">{t.role_fr}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

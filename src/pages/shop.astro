---
import Layout from '../layouts/Layout.astro';
import { products, categories, categoryIcons } from '../data/products.js';
---
<Layout title="Produtos" description="Catálogo completo de produtos B3 Global — mais de 150 produtos brasileiros premium para importação e exportação.">

  <!-- PAGE HEADER -->
  <section class="bg-navy-950 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-gold-400 text-xs font-semibold tracking-widest uppercase mb-1">B3 Global</p>
      <h1 class="font-display font-bold text-3xl md:text-4xl text-white">
        <span class="lang-pt">Nosso Catálogo</span>
        <span class="lang-en">Our Catalog</span>
        <span class="lang-fr">Notre Catalogue</span>
      </h1>
      <p class="text-slate-400 mt-2 text-sm">
        <span class="lang-pt">{products.length} produtos disponíveis para importação e exportação</span>
        <span class="lang-en">{products.length} products available for import and export</span>
        <span class="lang-fr">{products.length} produits disponibles pour l'importation et l'exportation</span>
      </p>
    </div>
  </section>

  <!-- TOOLBAR -->
  <section class="sticky top-16 z-40 bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input id="search-input" type="text" class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all" />
        </div>
      </div>
      <div class="flex items-center gap-2 mt-3 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none;">
        <button data-cat="all" onclick="filterCat('all')" class="cat-btn shrink-0 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold border border-navy-900 bg-navy-900 text-white transition-all whitespace-nowrap">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <span class="lang-pt">Todos</span><span class="lang-en">All</span><span class="lang-fr">Tous</span>
        </button>
        {categories.map(cat => (
          <button data-cat={cat.id} onclick={`filterCat('${cat.id}')`} class="cat-btn shrink-0 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold border border-slate-200 bg-white text-slate-600 hover:border-navy-700 hover:text-navy-800 transition-all whitespace-nowrap">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[cat.id]}></svg>
            <span class="lang-pt">{cat.label_pt}</span>
            <span class="lang-en">{cat.label_en}</span>
            <span class="lang-fr">{cat.label_fr}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS GRID -->
  <section class="py-10 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <p id="results-count" class="text-sm text-slate-500">
          <span id="count-num" class="font-semibold text-navy-800">{products.length}</span>
          <span class="lang-pt"> produtos encontrados</span>
          <span class="lang-en"> products found</span>
          <span class="lang-fr"> produits trouvés</span>
        </p>
      </div>

      <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {products.map(p => {
          const cat = categories.find(c => c.id === p.category);
          return (
            <div
              class="product-card group bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-slate-300 hover:-translate-y-0.5 transition-all"
              data-category={p.category}
              data-name={p.name.toLowerCase()}
              data-tags={p.tags.join(' ')}
            >
              <!-- Product Image -->
              <div class="relative bg-slate-100 aspect-square overflow-hidden">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-10 h-10 text-slate-300\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'/></svg></div>'"
                />
              </div>
              <!-- Card body -->
              <div class="p-3">
                <p class="text-[10px] text-slate-400 font-medium uppercase tracking-wide mb-1">
                  <span class="lang-pt">{cat?.label_pt}</span>
                  <span class="lang-en">{cat?.label_en}</span>
                  <span class="lang-fr">{cat?.label_fr}</span>
                </p>
                <h3 class="font-semibold text-navy-900 text-xs leading-snug mb-2.5 min-h-[2rem] line-clamp-2">{p.name}</h3>
                <a href="/contact" class="flex items-center justify-center gap-1 w-full bg-slate-100 hover:bg-navy-900 text-navy-800 hover:text-white font-semibold text-[10px] py-2 rounded-lg transition-all">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="lang-pt">Solicitar Cotação</span>
                  <span class="lang-en">Request Quote</span>
                  <span class="lang-fr">Demander un Devis</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-24">
        <svg class="w-14 h-14 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <h3 class="font-display font-bold text-xl text-navy-900 mb-2">
          <span class="lang-pt">Nenhum produto encontrado</span>
          <span class="lang-en">No products found</span>
          <span class="lang-fr">Aucun produit trouvé</span>
        </h3>
        <p class="text-slate-500 text-sm mb-6">
          <span class="lang-pt">Tente uma busca diferente ou veja todas as categorias</span>
          <span class="lang-en">Try a different search or view all categories</span>
          <span class="lang-fr">Essayez une recherche différente ou consultez toutes les catégories</span>
        </p>
        <button onclick="filterCat('all'); document.getElementById('search-input').value=''; applyFilters();" class="inline-flex items-center gap-2 bg-navy-900 text-white font-semibold text-sm px-5 py-2.5 rounded-xl hover:bg-gold-500 hover:text-navy-900 transition-all">
          <span class="lang-pt">Ver Todos</span>
          <span class="lang-en">View All</span>
          <span class="lang-fr">Voir Tout</span>
        </button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-navy-900 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="font-display font-bold text-2xl text-white mb-3">
        <span class="lang-pt">Não encontrou o que procura?</span>
        <span class="lang-en">Didn't find what you're looking for?</span>
        <span class="lang-fr">Vous n'avez pas trouvé ce que vous cherchez ?</span>
      </h2>
      <p class="text-slate-400 text-sm mb-6">
        <span class="lang-pt">Entre em contato e consultamos nosso portfólio completo para você.</span>
        <span class="lang-en">Get in touch and we'll consult our full portfolio for you.</span>
        <span class="lang-fr">Contactez-nous et nous consulterons notre portefeuille complet pour vous.</span>
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold text-sm px-7 py-3 rounded-xl transition-all hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span class="lang-pt">Falar com a Equipe</span>
        <span class="lang-en">Talk to the Team</span>
        <span class="lang-fr">Parler à l'Équipe</span>
      </a>
    </div>
  </section>

</Layout>

<script is:inline>
  var currentCat = 'all';
  var currentSearch = '';

  (function() {
    var params = new URLSearchParams(window.location.search);
    var catParam = params.get('cat');
    if (catParam) filterCat(catParam);
    setPlaceholder();
    var obs = new MutationObserver(setPlaceholder);
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
  })();

  function setPlaceholder() {
    var lang = document.documentElement.getAttribute('data-lang') || 'pt';
    var input = document.getElementById('search-input');
    if (input) input.placeholder = lang === 'pt' ? 'Buscar produtos...' : lang === 'fr' ? 'Rechercher des produits...' : 'Search products...';
  }

  document.getElementById('search-input').addEventListener('input', function(e) {
    currentSearch = e.target.value.toLowerCase().trim();
    applyFilters();
  });

  function filterCat(cat) {
    currentCat = cat;
    document.querySelectorAll('.cat-btn').forEach(function(btn) {
      var isActive = btn.getAttribute('data-cat') === cat;
      if (isActive) {
        btn.classList.add('bg-navy-900','text-white','border-navy-900');
        btn.classList.remove('bg-white','text-slate-600','border-slate-200');
      } else {
        btn.classList.remove('bg-navy-900','text-white','border-navy-900');
        btn.classList.add('bg-white','text-slate-600','border-slate-200');
      }
    });
    applyFilters();
  }

  function applyFilters() {
    var cards = document.querySelectorAll('.product-card');
    var visible = 0;
    cards.forEach(function(card) {
      var catMatch = currentCat === 'all' || card.getAttribute('data-category') === currentCat;
      var searchMatch = !currentSearch || card.getAttribute('data-name').includes(currentSearch) || card.getAttribute('data-tags').includes(currentSearch);
      if (catMatch && searchMatch) { card.style.display = ''; visible++; }
      else card.style.display = 'none';
    });
    var countEl = document.getElementById('count-num');
    if (countEl) countEl.textContent = visible;
    var emptyState = document.getElementById('empty-state');
    var grid = document.getElementById('products-grid');
    if (visible === 0) { emptyState.classList.remove('hidden'); grid.style.display = 'none'; }
    else { emptyState.classList.add('hidden'); grid.style.display = ''; }
  }
</script>

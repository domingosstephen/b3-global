---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contato" description="Entre em contato com a B3 Global — solicite cotações, informações sobre produtos e parcerias comerciais.">

  <!-- PAGE HEADER -->
  <section class="bg-navy-950 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gold-400 text-xs font-semibold tracking-widest uppercase mb-3">B3 Global</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl text-white mb-4">
        <span class="lang-pt">Entre em Contato</span>
        <span class="lang-en">Get In Touch</span>
        <span class="lang-fr">Contactez-Nous</span>
      </h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto">
        <span class="lang-pt">Pronto para iniciar uma parceria? Nossa equipe responde em até 24 horas.</span>
        <span class="lang-en">Ready to start a partnership? Our team responds within 24 hours.</span>
        <span class="lang-fr">Prêt à démarrer un partenariat ? Notre équipe répond en moins de 24 heures.</span>
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12">

        <!-- Contact info (2/5) -->
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h2 class="font-display font-bold text-2xl text-navy-900 mb-5">
              <span class="lang-pt">Informações de Contato</span>
              <span class="lang-en">Contact Information</span>
              <span class="lang-fr">Informations de Contact</span>
            </h2>
            <div class="space-y-4">

              <!-- Email placeholder -->
              <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200">
                <div class="w-10 h-10 bg-navy-900 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-0.5">Email</div>
                  <div class="text-navy-900 font-medium text-sm text-slate-500 italic">
                    <!-- TO BE ADDED -->
                    <span class="lang-pt">A ser adicionado</span>
                    <span class="lang-en">To be added</span>
                  </div>
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200">
                <div class="w-10 h-10 bg-green-600 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.025.507 3.934 1.401 5.605L0 24l6.604-1.375A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-4.868-1.292l-.35-.208-3.621.754.766-3.53-.228-.362A9.818 9.818 0 1112 21.818z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-0.5">WhatsApp</div>
                  <a href="https://wa.me/5511953954562" class="text-navy-900 font-medium text-sm hover:text-gold-600 transition-colors">
                    +55 11 95395-4562
                  </a>
                </div>
              </div>

              <!-- Address placeholder -->
              <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200">
                <div class="w-10 h-10 bg-navy-900 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-0.5">
                    <span class="lang-pt">Endereço</span>
                    <span class="lang-en">Address</span>
                    <span class="lang-fr">Adresse</span>
                  </div>
                  <div class="text-slate-500 italic text-sm">
                    <span class="lang-pt">Brasil (principal) · EUA · Canadá</span>
                    <span class="lang-en">Brazil (main) · USA · Canada</span>
                    <span class="lang-fr">Brésil (principal) · États-Unis · Canada</span>
                  </div>
                </div>
              </div>

              <!-- Support hours -->
              <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-slate-200">
                <div class="w-10 h-10 bg-gold-500 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-navy-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-0.5">
                    <span class="lang-pt">Suporte</span>
                    <span class="lang-en">Support</span>
                    <span class="lang-fr">Support</span>
                  </div>
                  <div class="text-navy-900 font-semibold text-sm">24/7</div>
                  <div class="text-slate-500 text-xs">
                    <span class="lang-pt">Sempre disponível</span>
                    <span class="lang-en">Always available</span>
                    <span class="lang-fr">Toujours disponible</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Guarantees -->
          <div class="bg-navy-950 rounded-2xl p-6">
            <h3 class="font-display font-semibold text-white text-sm mb-4">
              <span class="lang-pt">Nossas Garantias</span>
              <span class="lang-en">Our Guarantees</span>
              <span class="lang-fr">Nos Garanties</span>
            </h3>
            <ul class="space-y-3">
              {[
                { pt: 'Resposta em até 24 horas', en: 'Response within 24 hours', fr: 'Réponse en moins de 24 heures' },
                { pt: 'Cotação sem compromisso', en: 'No-obligation quote', fr: 'Devis sans engagement' },
                { pt: 'Suporte multilíngue', en: 'Multilingual support', fr: 'Support multilingue' },
                { pt: 'Entrega via DHL rastreada', en: 'Tracked DHL delivery', fr: 'Livraison DHL avec suivi' },
                { pt: 'Garantia 100% satisfação', en: '100% satisfaction guarantee', fr: 'Garantie 100% satisfaction' },
              ].map(item => (
                <li class="flex items-center gap-2.5 text-sm">
                  <span class="w-4 h-4 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-400 text-[10px] shrink-0">✓</span>
                  <span class="text-slate-300">
                    <span class="lang-pt">{item.pt}</span>
                    <span class="lang-en">{item.en}</span>
                    <span class="lang-fr">{item.fr}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Contact form (3/5) -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
            <h2 class="font-display font-bold text-2xl text-navy-900 mb-2">
              <span class="lang-pt">Envie uma Mensagem</span>
              <span class="lang-en">Send a Message</span>
              <span class="lang-fr">Envoyez un Message</span>
            </h2>
            <p class="text-slate-500 text-sm mb-7">
              <span class="lang-pt">Descreva os produtos que você precisa e entraremos em contato com uma proposta.</span>
              <span class="lang-en">Describe the products you need and we'll get back to you with a proposal.</span>
            </p>

            <form id="contact-form" class="space-y-5" onsubmit="handleSubmit(event)">
              <div class="grid sm:grid-cols-2 gap-5">
                <!-- Name -->
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    <span class="lang-pt">Nome Completo *</span>
                    <span class="lang-en">Full Name *</span>
                  </label>
                  <input type="text" name="name" required
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all" />
                </div>
                <!-- Email -->
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    <span class="lang-pt">E-mail *</span>
                    <span class="lang-en">Email *</span>
                  </label>
                  <input type="email" name="email" required
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all" />
                </div>
              </div>

              <!-- Phone -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                  <span class="lang-pt">Telefone / WhatsApp</span>
                  <span class="lang-en">Phone / WhatsApp</span>
                </label>
                <input type="tel" name="phone"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all" />
              </div>

              <!-- Company -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                  <span class="lang-pt">Empresa</span>
                  <span class="lang-en">Company</span>
                </label>
                <input type="text" name="company"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all" />
              </div>

              <!-- Message -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                  <span class="lang-pt">Mensagem *</span>
                  <span class="lang-en">Message *</span>
                </label>
                <textarea name="message" rows="5" required
                  id="msg-textarea"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-transparent transition-all resize-none"></textarea>
              </div>

              <!-- Submit -->
              <button type="submit"
                class="w-full bg-navy-900 hover:bg-gold-500 text-white hover:text-navy-900 font-bold text-sm py-3.5 rounded-xl transition-all hover:-translate-y-0.5">
                <span class="lang-pt">Enviar Mensagem</span>
                <span class="lang-en">Send Message</span>
                <span class="lang-fr">Envoyer le Message</span>
              </button>

              <!-- Success message -->
              <div id="form-success" class="hidden text-center py-4 bg-green-50 border border-green-200 rounded-xl">
                <div class="text-2xl mb-2">✅</div>
                <p class="text-green-800 font-semibold text-sm">
                  <span class="lang-pt">Mensagem enviada! Entraremos em contato em breve.</span>
                  <span class="lang-en">Message sent! We'll get back to you shortly.</span>
                </p>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  // Set textarea placeholder based on lang
  function setFormPlaceholders() {
    var lang = document.documentElement.getAttribute('data-lang') || 'pt';
    var textarea = document.getElementById('msg-textarea');
    if (textarea) {
      textarea.placeholder = lang === 'pt'
        ? 'Descreva os produtos que você precisa, quantidades e destino...'
        : 'Describe the products you need, quantities and destination...';
    }
  }
  setFormPlaceholders();
  var obs = new MutationObserver(setFormPlaceholders);
  obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

  function handleSubmit(e) {
    e.preventDefault();
    // Show success state (form integration to be added)
    document.getElementById('contact-form').style.opacity = '0.5';
    document.getElementById('contact-form').style.pointerEvents = 'none';
    document.getElementById('form-success').classList.remove('hidden');
    document.getElementById('contact-form').style.opacity = '1';
  }
</script>
